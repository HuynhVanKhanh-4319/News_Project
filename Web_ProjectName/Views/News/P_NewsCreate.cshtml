@model EM_News

<div class="container py-3">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Thêm tin tức</h5>
        </div>
        <div class="card-body">
            <form id="form_create_news" class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="name" class="form-label">Tiêu đề</label>
                    <input asp-for="name" class="form-control" maxlength="250" required />
                    <span asp-validation-for="name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="metaTitle" class="form-label">Meta Title</label>
                    <input asp-for="metaTitle" class="form-control" maxlength="100" />
                    <span asp-validation-for="metaTitle" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="metaDescription" class="form-label">Meta Description</label>
                    <input asp-for="metaDescription" class="form-control" maxlength="160" />
                    <span asp-validation-for="metaDescription" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="metaKeywords" class="form-label">Meta Keywords</label>
                    <input asp-for="metaKeywords" class="form-control" maxlength="100" />
                    <span asp-validation-for="metaKeywords" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="metaUrl" class="form-label">
                        Meta URL <span class="text-danger d-inline">*</span></label>
                    <input asp-for="metaUrl" class="form-control" maxlength="200" required />
                    <span asp-validation-for="metaUrl" class="text-danger"></span>
                </div>


                <div class="col-12 col-md-6">
                    <label asp-for="metaImagePreview" class="form-label">Meta Image Preview (URL)</label>
                    <input asp-for="metaImagePreview" class="form-control" maxlength="200" />
                    <span asp-validation-for="metaImagePreview" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label for="newsCategoryId" class="form-label">Danh mục</label>
                    <select id="newsCategoryId" name="newsCategoryId" class="form-select" required></select>
                    <span asp-validation-for="newsCategoryId" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="publishedAt" class="form-label">Ngày đăng</label>
                    <input asp-for="publishedAt" type="text" class="form-control datepicker" autocomplete="off" required />
                    <span asp-validation-for="publishedAt" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="description" class="form-label">Mô tả</label>
                    <textarea asp-for="description" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="description" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input type="hidden" name="isHot" value="false" />
                        <input type="checkbox" class="form-check-input" id="isHot" name="isHot" value="true" />
                        <label class="form-check-label" for="isHot">Tin nổi bật</label>
                    </div>
                </div>

                <input type="hidden" name="status" value="1" />

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary px-4">Lưu</button>
                    <button type="button" class="btn btn-secondary px-4 ms-2" data-bs-dismiss="modal">Thoát</button>
                </div>
            </form>
        </div>
    </div>
</div>
