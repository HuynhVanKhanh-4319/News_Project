<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-3">
            <label for="fromDate" class="form-label fw-bold">Từ ngày</label>
            <input type="text" id="fromDate" class="datepicker form-control" placeholder="Chọn ngày bắt đầu" />
        </div>
        <div class="col-md-3">
            <label for="toDate" class="form-label fw-bold">Đến ngày</label>
            <input type="text" id="toDate" class="datepicker form-control" placeholder="Chọn ngày kết thúc" />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3"><i class="fa fa-chart-bar"></i> Biểu đồ thống kê</h5>
            <div id="chart"></div>
        </div>
    </div>
</div>
